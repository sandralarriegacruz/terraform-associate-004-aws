# Local .terraform directories
**/.terraform/

# .tfstate files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json
# Exceptional allow for example tfvars
!*.tfvars.example

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Sensitive keys and environment files
*.pem
*.key
.env
aws_credentials
aws_credentials.txt

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
